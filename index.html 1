<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BYENZO – Vos menus en ligne</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lato:wght@300;400;700&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
<style>
:root {
  --red: #d4a843; --red-dark: #1a1a1a; --dark: #1a1a1a; --darker: #0a0a0a;
  --light: #f5f5f5; --grey: #222222; --grey2: #333333; --gold: #d4a843; --white: #fff;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { background: var(--darker); color: var(--light); font-family: 'Lato', sans-serif; font-weight: 300; line-height: 1.5; }

/* PAGES */
.page { display: none; min-height: 100vh; }
.page.active { display: block; }

/* ══ PAGE ACCUEIL ══ */
.home-header { background: #111111; text-align: center; padding: 3rem 1rem 2.5rem; position: relative; overflow: hidden; }
.home-header::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(45deg,transparent,transparent 12px,rgba(0,0,0,0.07) 12px,rgba(0,0,0,0.07) 24px); }
.home-header h1 { font-family:'Bebas Neue',sans-serif; font-size:clamp(3rem,10vw,5.5rem); color:white; letter-spacing:0.1em; position:relative; text-shadow:3px 3px 0 rgba(0,0,0,0.3); }
.home-header p { position:relative; color:rgba(255,255,255,0.7); font-size:0.85rem; letter-spacing:0.2em; text-transform:uppercase; margin-top:0.5rem; }
.home-main { max-width:960px; margin:0 auto; padding:3rem 1.5rem; }
.home-intro { text-align:center; margin-bottom:3rem; }
.home-intro h2 { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; letter-spacing:0.1em; color:var(--gold); margin-bottom:0.5rem; }
.home-intro p { font-size:0.9rem; color:rgba(255,255,255,0.45); }
.resto-card { background:var(--grey); border:1px solid var(--grey2); border-radius:4px; overflow:hidden; cursor:pointer; transition:transform 0.25s, border-color 0.25s; max-width:340px; }
.resto-card:hover { transform:translateY(-5px); border-color:var(--gold); }
.card-top { background: linear-gradient(135deg, #1a1a1a, #2a2a2a); border-bottom: 2px solid var(--gold); padding:1.8rem 1.5rem 1.4rem; position:relative; overflow:hidden; }
.card-top::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(45deg,transparent,transparent 8px,rgba(0,0,0,0.06) 8px,rgba(0,0,0,0.06) 16px); }
.card-top h3 { font-family:'Bebas Neue',sans-serif; font-size:2rem; color:white; position:relative; text-shadow:2px 2px 0 rgba(0,0,0,0.25); }
.card-top .type { font-size:0.72rem; letter-spacing:0.25em; color:rgba(255,255,255,0.65); text-transform:uppercase; position:relative; margin-top:0.2rem; }
.card-body { padding:1.2rem 1.5rem 1.5rem; }
.card-tags { display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1rem; }
.tag { background:var(--grey2); font-size:0.72rem; padding:0.25rem 0.6rem; border-radius:2px; color:rgba(255,255,255,0.55); }
.card-cta { font-family:'Bebas Neue',sans-serif; font-size:1rem; letter-spacing:0.1em; color:var(--gold); }
.home-footer { text-align:center; padding:2rem; font-size:0.75rem; color:rgba(255,255,255,0.2); border-top:1px solid var(--grey2); margin-top:2rem; }
.home-footer span { color:var(--gold); }

/* ══ PAGE MENU ══ */
.menu-header { background:var(--red-dark); text-align:center; padding:2.5rem 1rem 2rem; position:relative; overflow:hidden; }
.menu-header::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(0,0,0,0.08) 10px,rgba(0,0,0,0.08) 20px); }
.menu-header h1 { font-family:'Bebas Neue',sans-serif; font-size:clamp(3rem,10vw,5.5rem); letter-spacing:0.08em; color:var(--white); position:relative; text-shadow:3px 3px 0 rgba(0,0,0,0.4); }
.menu-header .tagline { font-family:'Playfair Display',serif; font-style:italic; color:var(--gold); font-size:1rem; letter-spacing:0.2em; position:relative; margin-top:0.3rem; }
.menu-header .notice { position:relative; margin-top:0.8rem; font-size:0.72rem; color:rgba(255,255,255,0.6); }
nav { background:#111111; border-bottom: 2px solid var(--gold) !important; display:flex; flex-wrap:wrap; justify-content:center; position:sticky; top:0; z-index:100; border-bottom:2px solid var(--red); }
nav a { color:rgba(255,255,255,0.6); text-decoration:none; font-family:'Bebas Neue',sans-serif; font-size:0.95rem; letter-spacing:0.1em; padding:0.75rem 0.8rem; transition:color 0.2s,background 0.2s; }
nav a:hover { color:var(--white); background:var(--red); }
.back-btn { display:inline-flex; align-items:center; gap:0.4rem; background:var(--red); color:white; border:none; cursor:pointer; font-family:'Bebas Neue',sans-serif; font-size:0.85rem; letter-spacing:0.1em; padding:0.5rem 1rem; position:fixed; bottom:1.2rem; left:1rem; z-index:200; border-radius:2px; }
.section { max-width:900px; margin:0 auto; padding:2.5rem 1rem; }
.section-header { display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem; }
.section-header h2 { font-family:'Bebas Neue',sans-serif; font-size:clamp(1.8rem,5vw,2.8rem); letter-spacing:0.06em; color:var(--white); white-space:nowrap; }
.section-header .line { flex:1; height:2px; background:linear-gradient(90deg,var(--red),transparent); }
.section-sub { color:var(--gold); font-size:0.85rem; letter-spacing:0.15em; text-transform:uppercase; margin-bottom:1.2rem; }
.formulas { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-bottom:0.5rem; }
.formula-card { background:var(--grey); border-left:4px solid var(--red); padding:1.2rem; border-radius:2px; }
.formula-card h3 { font-family:'Bebas Neue',sans-serif; font-size:1.2rem; color:var(--red); }
.formula-card .price { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; color:var(--gold); margin:0.3rem 0; }
.formula-card p { font-size:0.9rem; color:rgba(255,255,255,0.65); line-height:1.5; }
.items-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1px; background:var(--grey2); border:1px solid var(--grey2); border-radius:2px; overflow:hidden; }
.item { background:var(--dark); padding:1.1rem 1.2rem; display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; }
.item:hover { background:var(--grey); }
.item-info { flex:1; }
.item-name { font-weight:700; font-size:1.05rem; color:var(--white); line-height:1.3; }
.item-desc { font-size:0.88rem; color:rgba(255,255,255,0.5); margin-top:0.2rem; line-height:1.4; }
.item-price { font-family:'Bebas Neue',sans-serif; font-size:1.4rem; color:var(--gold); white-space:nowrap; }
.divider { border:none; border-top:1px solid var(--grey2); margin:2rem 0; }
.enfant-block { background:var(--grey); border:1px solid var(--red); padding:1.2rem 1.5rem; border-radius:2px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; }
.enfant-block h3 { font-family:'Bebas Neue',sans-serif; font-size:1.4rem; color:var(--red); }
.enfant-block p { font-size:0.95rem; color:rgba(255,255,255,0.65); max-width:480px; }
.enfant-block .price { font-family:'Bebas Neue',sans-serif; font-size:1.8rem; color:var(--gold); }
.assiettes-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
.assiette-card { background:var(--grey); padding:1.2rem; border-top:3px solid var(--red); border-radius:2px; }
.assiette-card h3 { font-family:'Bebas Neue',sans-serif; font-size:1.2rem; color:var(--white); margin-bottom:0.3rem; }
.assiette-card .price { font-family:'Bebas Neue',sans-serif; font-size:1.7rem; color:var(--gold); margin-top:0.5rem; }
.big-highlight { background:linear-gradient(135deg,var(--red-dark),#6b0f20); border:2px solid var(--gold); padding:1.5rem; border-radius:4px; display:flex; align-items:center; gap:1.5rem; margin-bottom:1.2rem; flex-wrap:wrap; }
.big-highlight .badge { font-family:'Bebas Neue',sans-serif; font-size:3.5rem; color:var(--gold); line-height:1; }
.big-highlight h3 { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; color:var(--white); }
.big-highlight p { font-size:0.92rem; color:rgba(255,255,255,0.7); margin-top:0.3rem; }
.big-highlight .price { font-family:'Bebas Neue',sans-serif; font-size:2rem; color:var(--gold); margin-top:0.3rem; }
.menu-footer { background:var(--grey); text-align:center; padding:2rem 1rem 5rem; font-size:0.78rem; color:rgba(255,255,255,0.35); letter-spacing:0.1em; border-top:2px solid var(--red); }
.menu-footer span { color:var(--gold); }
@media(max-width:500px){ .items-grid{grid-template-columns:1fr;} nav a{font-size:0.72rem;padding:0.6rem 0.5rem;} }

/* ══ BOUTON PLATS DU JOUR ══ */
.pdj-btn-wrap { max-width:900px; margin:0 auto; padding:0 1rem; }
.pdj-btn {
  display:flex; align-items:center; justify-content:center; gap:0.8rem;
  background:var(--gold); color:var(--darker);
  font-family:'Bebas Neue',sans-serif; font-size:1.2rem; letter-spacing:0.12em;
  padding:1rem 2rem; border:none; cursor:pointer; width:100%;
  border-radius:3px; transition:background 0.2s; margin-bottom:0;
}
.pdj-btn:hover { background:#e8c97a; }
.pdj-dot { width:9px; height:9px; background:var(--red); border-radius:50%; animation:pdj-pulse 1.4s infinite; flex-shrink:0; }
@keyframes pdj-pulse { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.6);opacity:0.5;} }

/* ══ POPUP ══ */
@import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap');
.popup-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); z-index:500; align-items:center; justify-content:center; padding:1rem; }
.popup-overlay.open { display:flex; }
.popup {
  background: #f5f0e8;
  border: 3px solid #8b6914;
  border-radius: 4px;
  width: 100%;
  max-width: 480px;
  max-height: 92vh;
  overflow-y: auto;
  animation: popIn 0.25s ease;
  position: relative;
}
.popup::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(139,105,20,0.3);
  pointer-events: none;
  z-index: 1;
}
@keyframes popIn { from{opacity:0;transform:scale(0.93);} to{opacity:1;transform:scale(1);} }
.popup-head {
  background: transparent;
  padding: 1.8rem 1.5rem 0.5rem;
  text-align: center;
  position: relative;
}
.popup-close {
  position: absolute;
  top: 0.8rem; right: 0.8rem;
  background: none; border: none;
  color: #8b6914; font-size: 1.4rem;
  cursor: pointer; line-height: 1;
  z-index: 2;
}
.popup-close:hover { color: #5a3e0a; }
.popup-cutlery {
  font-size: 1.4rem;
  color: #8b6914;
  letter-spacing: 0.3em;
  margin-bottom: 0.3rem;
}
.popup-head h3 {
  font-family: 'Pinyon Script', cursive;
  font-size: 3rem;
  color: #5a3e0a;
  line-height: 1.1;
}
.popup-price-badge {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.1rem;
  color: #8b6914;
  margin: 0.4rem 0 0.8rem;
  letter-spacing: 0.05em;
}
.popup-divider {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0 1.5rem; margin-bottom: 0.5rem;
}
.popup-divider::before, .popup-divider::after {
  content: ''; flex: 1; height: 1px; background: #c4a44a;
}
.popup-divider span { color: #c4a44a; font-size: 0.7rem; }
.popup-body { padding: 0.5rem 1.5rem 1.5rem; }
.pdj-day {
  padding: 0.9rem 0;
  border-bottom: 1px solid rgba(139,105,20,0.2);
  text-align: center;
}
.pdj-day:last-child { border-bottom: none; }
.pdj-day .day-label {
  font-family: 'Pinyon Script', cursive;
  font-size: 1.9rem;
  color: #5a3e0a;
  line-height: 1.2;
}
.pdj-day .day-dish {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 1rem;
  color: #3a2a0a;
  margin-top: 0.2rem;
  line-height: 1.5;
}
.pdj-note { font-family:'Cormorant Garamond',serif; font-size:0.8rem; color:rgba(90,62,10,0.45); text-align:center; margin-top:1rem; font-style:italic; }
</style>
</head>
<body>

